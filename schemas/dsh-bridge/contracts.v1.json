{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://openduck.local/schemas/dsh-bridge/contracts.v1.json",
  "type":"object","additionalProperties":false,
  "$defs":{
    "safeProjection":{"type":"object","additionalProperties":false,"required":["classification","provenance","proof","version","expires_at"],"properties":{"classification":{"enum":["L0","L1"]},"provenance":{"type":"string","minLength":1},"proof":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"version":{"type":"integer","minimum":1},"expires_at":{"type":"string","format":"date-time"}}},
    "uiChannelSession":{"type":"object","additionalProperties":false,"required":["schema_version","session_id","channel_id","token","client_nonce","origin","host","issued_at","expires_at","ephemeral","persistent"],"properties":{"schema_version":{"const":"ui-channel-session.v1"},"session_id":{"type":"string","minLength":1},"channel_id":{"type":"string","minLength":1},"token":{"type":"string","minLength":32},"client_nonce":{"type":"string","minLength":1},"origin":{"type":"string","minLength":1},"host":{"type":"string","minLength":1},"issued_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"ephemeral":{"const":true},"persistent":{"const":false}}},
    "composerCloud":{"type":"object","additionalProperties":false,"required":["schema_version","route","admission_id","status"],"properties":{"schema_version":{"const":"composer-admission-result.v1"},"route":{"const":"cloud"},"admission_id":{"type":"string","pattern":"^adm_[A-Za-z0-9_-]{8,120}$"},"status":{"enum":["pending","accepted","consumed","uncertain","denied"]}}},
    "composerLocalPD":{"type":"object","additionalProperties":false,"required":["schema_version","route","local_pd_handle","status"],"properties":{"schema_version":{"const":"composer-admission-result.v1"},"route":{"const":"local_pd"},"local_pd_handle":{"type":"string","pattern":"^pd_[A-Za-z0-9_-]{8,120}$"},"status":{"enum":["queued","running","completed","expired","denied"]}}},
    "inboxItem":{"type":"object","additionalProperties":false,"required":["id","summary","source","classification","updated_at"],"properties":{"id":{"type":"string"},"summary":{"type":"string"},"source":{"type":"string"},"classification":{"enum":["L0","L1"]},"updated_at":{"type":"string","format":"date-time"}}},
    "calendarItem":{"type":"object","additionalProperties":false,"required":["id","title","start","end","timezone","status"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"start":{"type":"string","format":"date-time"},"end":{"type":"string","format":"date-time"},"timezone":{"type":"string"},"status":{"type":"string"}}},
    "graphNode":{"type":"object","additionalProperties":false,"required":["id","title","status"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"status":{"type":"string"},"planned_start":{"type":"string","format":"date-time"},"planned_end":{"type":"string","format":"date-time"}}},
    "graphEdge":{"type":"object","additionalProperties":false,"required":["from","to","kind"],"properties":{"from":{"type":"string"},"to":{"type":"string"},"kind":{"type":"string"}}},
    "taskItem":{"type":"object","additionalProperties":false,"required":["id","title","status","source","version"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"status":{"type":"string"},"source":{"type":"string"},"version":{"type":"integer","minimum":0}}},
    "reviewItem":{"type":"object","additionalProperties":false,"required":["id","target_id","status","finding_count"],"properties":{"id":{"type":"string"},"target_id":{"type":"string"},"status":{"type":"string"},"finding_count":{"type":"integer","minimum":0}}},
    "memoryItem":{"type":"object","additionalProperties":false,"required":["id","scope","sensitivity","status","provenance_count"],"properties":{"id":{"type":"string"},"scope":{"type":"string"},"sensitivity":{"type":"string"},"status":{"type":"string"},"provenance_count":{"type":"integer","minimum":0}}},
    "inbox":{"type":"object","additionalProperties":false,"required":["schema_version","projection","items","generated_at"],"properties":{"schema_version":{"const":"command-center-read-model.v1"},"projection":{"$ref":"#/$defs/safeProjection"},"items":{"type":"array","items":{"$ref":"#/$defs/inboxItem"}},"generated_at":{"type":"string","format":"date-time"}}},
    "calendar":{"type":"object","additionalProperties":false,"required":["schema_version","projection","items","generated_at"],"properties":{"schema_version":{"const":"command-center-read-model.v1"},"projection":{"$ref":"#/$defs/safeProjection"},"items":{"type":"array","items":{"$ref":"#/$defs/calendarItem"}},"generated_at":{"type":"string","format":"date-time"}}},
    "workgraph":{"type":"object","additionalProperties":false,"required":["schema_version","projection","graph_id","baseline_version","nodes","edges","generated_at"],"properties":{"schema_version":{"const":"command-center-read-model.v1"},"projection":{"$ref":"#/$defs/safeProjection"},"graph_id":{"type":"string"},"baseline_version":{"type":"string"},"nodes":{"type":"array","items":{"$ref":"#/$defs/graphNode"}},"edges":{"type":"array","items":{"$ref":"#/$defs/graphEdge"}},"generated_at":{"type":"string","format":"date-time"}}},
    "tasks":{"type":"object","additionalProperties":false,"required":["schema_version","projection","items","generated_at"],"properties":{"schema_version":{"const":"command-center-read-model.v1"},"projection":{"$ref":"#/$defs/safeProjection"},"items":{"type":"array","items":{"$ref":"#/$defs/taskItem"}},"generated_at":{"type":"string","format":"date-time"}}},
    "time":{"type":"object","additionalProperties":false,"required":["schema_version","projection","planned_seconds","spent_seconds","generated_at"],"properties":{"schema_version":{"const":"command-center-read-model.v1"},"projection":{"$ref":"#/$defs/safeProjection"},"active_task_id":{"type":"string"},"planned_seconds":{"type":"integer","minimum":0},"spent_seconds":{"type":"integer","minimum":0},"generated_at":{"type":"string","format":"date-time"}}},
    "reviews":{"type":"object","additionalProperties":false,"required":["schema_version","projection","items","generated_at"],"properties":{"schema_version":{"const":"command-center-read-model.v1"},"projection":{"$ref":"#/$defs/safeProjection"},"items":{"type":"array","items":{"$ref":"#/$defs/reviewItem"}},"generated_at":{"type":"string","format":"date-time"}}},
    "memory":{"type":"object","additionalProperties":false,"required":["schema_version","projection","items","generated_at"],"properties":{"schema_version":{"const":"command-center-read-model.v1"},"projection":{"$ref":"#/$defs/safeProjection"},"items":{"type":"array","items":{"$ref":"#/$defs/memoryItem"}},"generated_at":{"type":"string","format":"date-time"}}},
    "health":{"type":"object","additionalProperties":false,"required":["schema_version","projection","status","controller_available","effects_enabled","generated_at"],"properties":{"schema_version":{"const":"command-center-read-model.v1"},"projection":{"$ref":"#/$defs/safeProjection"},"status":{"type":"string"},"controller_available":{"type":"boolean"},"effects_enabled":{"type":"boolean"},"generated_at":{"type":"string","format":"date-time"}}},
    "inboxEnvelope":{"type":"object","additionalProperties":false,"required":["schema_version","route","data"],"properties":{"schema_version":{"const":"command-center-read-model.v1"},"route":{"const":"inbox"},"data":{"$ref":"#/$defs/inbox"}}},
    "calendarEnvelope":{"type":"object","additionalProperties":false,"required":["schema_version","route","data"],"properties":{"schema_version":{"const":"command-center-read-model.v1"},"route":{"const":"calendar"},"data":{"$ref":"#/$defs/calendar"}}},
    "workgraphEnvelope":{"type":"object","additionalProperties":false,"required":["schema_version","route","data"],"properties":{"schema_version":{"const":"command-center-read-model.v1"},"route":{"const":"workgraph"},"data":{"$ref":"#/$defs/workgraph"}}},
    "tasksEnvelope":{"type":"object","additionalProperties":false,"required":["schema_version","route","data"],"properties":{"schema_version":{"const":"command-center-read-model.v1"},"route":{"const":"tasks"},"data":{"$ref":"#/$defs/tasks"}}},
    "timeEnvelope":{"type":"object","additionalProperties":false,"required":["schema_version","route","data"],"properties":{"schema_version":{"const":"command-center-read-model.v1"},"route":{"const":"time"},"data":{"$ref":"#/$defs/time"}}},
    "reviewsEnvelope":{"type":"object","additionalProperties":false,"required":["schema_version","route","data"],"properties":{"schema_version":{"const":"command-center-read-model.v1"},"route":{"const":"reviews"},"data":{"$ref":"#/$defs/reviews"}}},
    "memoryEnvelope":{"type":"object","additionalProperties":false,"required":["schema_version","route","data"],"properties":{"schema_version":{"const":"command-center-read-model.v1"},"route":{"const":"memory-metadata"},"data":{"$ref":"#/$defs/memory"}}},
    "healthEnvelope":{"type":"object","additionalProperties":false,"required":["schema_version","route","data"],"properties":{"schema_version":{"const":"command-center-read-model.v1"},"route":{"const":"health"},"data":{"$ref":"#/$defs/health"}}}
  }
}
