{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openduck.local/schemas/workspace-group.v1.json",
  "title": "Controller WorkspaceGroup safe contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "group_id", "display_label", "primary_root_id", "roots", "version", "digest", "updated_at"],
  "properties": {
    "schema_version": {"const": "workspace-group.v1"},
    "group_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"},
    "display_label": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[\\x20-\\x7E]{1,128}$"},
    "primary_root_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"},
    "roots": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/root"}},
    "beads_scope_ref": {"type": "string", "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"},
    "beads_capability_refs": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"}},
	"version": {"type": "integer", "minimum": 1},
	"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
	"updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"root": {"type": "object", "additionalProperties": false, "required": ["root_id", "label", "mode"], "properties": {"root_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"}, "label": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[\\x20-\\x7E]{1,128}$"}, "mode": {"enum": ["read", "write"]}}}}
}
