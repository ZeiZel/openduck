{
  "name": "@openduck/openduck-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenDuck's generic native DeepSeek Harness base bundle; external work plugins compose above it.",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./contract": "./src/contract.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "connect",
    "cordis.patch.yml",
    "native-providers.patch.yml",
    "native-computer.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.1.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.7"
  },
  "scripts": {
    "build:client": "bun scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json && find src lib test -type f \\( -name '*.js' -o -name '*.mjs' \\) -exec node --check {} \\;"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
