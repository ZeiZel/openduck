(version 1)
(deny default)
(import "system.sb")
(allow process*)
(allow file-read* (subpath "/System") (subpath "/usr") (subpath "/Library/Apple"))
(allow file-read* (subpath "/Library/Application Support/OpenDuck/home/runtime"))
(allow file-write* (subpath "/Library/Application Support/OpenDuck/home/runtime"))
(allow file-read* (subpath "/Library/Application Support/OpenDuck/releases/codex"))
(allow network-outbound (remote tcp "localhost:8790"))
